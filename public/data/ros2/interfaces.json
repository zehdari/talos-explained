omment","t":"# ========================================"},{"k":"comment","t":"# Constants"},{"k":"comment","t":"# ========================================"},{"k":"blank","t":""},{"k":"comment","t":"# The number of kill switches defined below"},{"k":"const","t":"uint8 NUM_KILL_SWITCHES=4","type":"uint8","name":"NUM_KILL_SWITCHES","value":"4"},{"k":"blank","t":""},{"k":"comment","t":"# ========================================"},{"k":"comment","t":"# Kill Switch IDs"},{"k":"comment","t":"# ========================================"},{"k":"blank","t":""},{"k":"comment","t":"# Note: Do not publish as physical kill switch"},{"k":"const","t":"uint8 KILL_SWITCH_PHYSICAL=0","type":"uint8","name":"KILL_SWITCH_PHYSICAL","value":"0"},{"k":"blank","t":""},{"k":"comment","t":"# RQT Kill switch is for use in the controllers rqt plugin"},{"k":"const","t":"uint8 KILL_SWITCH_RQT_CONTROLLER=1","type":"uint8","name":"KILL_SWITCH_RQT_CONTROLLER","value":"1"},{"k":"blank","t":""},{"k":"comment","t":"# The kill switch from the physical topside kill switch button"},{"k":"const","t":"uint8 KILL_SWITCH_TOPSIDE_BUTTON=2","type":"uint8","name":"KILL_SWITCH_TOPSIDE_BUTTON","value":"2"},{"k":"blank","t":""},{"k":"comment","t":"# Debug kill switch should be used when publishing from command line or rqt manual publishing"},{"k":"comment","t":"# It is not recommended, but to avoid confusion this is implemented to allow manual publishing without conflicting"},{"k":"const","t":"uint8 KILL_SWITCH_DEBUG=3","type":"uint8","name":"KILL_SWITCH_DEBUG","value":"3"},{"k":"blank","t":""},{"k":"comment","t":"# ========================================"},{"k":"comment","t":"# Message Definition"},{"k":"comment","t":"# ========================================"},{"k":"blank","t":""},{"k":"comment","t":"# The sender_id should uniquely identify the code running. This could be the node name because they should be unique"},{"k":"comment","t":"# This prevents from accidental re-enabling on kill from another node publishing as the same switch ID"},{"k":"field","t":"string sender_id","type":"string","name":"sender_id"},{"k":"blank","t":""},{"k":"comment","t":"# A switch ID defined above"},{"k":"field","t":"uint8 kill_switch_id","type":"uint8","name":"kill_switch_id"},{"k":"blank","t":""},{"k":"comment","t":"# If the switch is in a kill state, stopping all active operations"},{"k":"field","t":"bool switch_asserting_kill","type":"bool","name":"switch_asserting_kill"},{"k":"blank","t":""},{"k":"comment","t":"# If the switch needs to periodically update in order to keep out of kill state"},{"k":"field","t":"bool switch_needs_update","type":"bool","name":"switch_needs_update"}]},{"kind":"msg","name":"LedCommand","path":"riptide_msgs/msg/LedCommand.msg","lines":[{"k":"comment","t":"# color info"},{"k":"field","t":"uint8 red","type":"uint8","name":"red"},{"k":"field","t":"uint8 green","type":"uint8","name":"green"},{"k":"field","t":"uint8 blue","type":"uint8","name":"blue"},{"k":"blank","t":""},{"k":"comment","t":"# state info"},{"k":"field","t":"uint8 mode","type":"uint8","name":"mode"},{"k":"field","t":"uint8 target","type":"uint8","name":"target"},{"k":"blank","t":""},{"k":"comment","t":"# modes"},{"k":"const","t":"uint8 MODE_SOLID = 0","type":"uint8","name":"MODE_SOLID","value":"0"},{"k":"const","t":"uint8 MODE_SLOW_FLASH = 1","type":"uint8","name":"MODE_SLOW_FLASH","value":"1"},{"k":"const","t":"uint8 MODE_FAST_FLASH = 2","type":"uint8","name":"MODE_FAST_FLASH","value":"2"},{"k":"const","t":"uint8 MODE_BREATH = 3","type":"uint8","name":"MODE_BREATH","value":"3"},{"k":"const","t":"uint8 SINGLETON_FLASH = 4","type":"uint8","name":"SINGLETON_FLASH","value":"4"},{"k":"blank","t":""},{"k":"comment","t":"# targets"},{"k":"const","t":"uint8 TARGET_NONE = 0","type":"uint8","name":"TARGET_NONE","value":"0"},{"k":"const","t":"uint8 TARGET_CCB = 1","type":"uint8","name":"TARGET_CCB","value":"1"},{"k":"const","t":"uint8 TARGET_ALU = 2","type":"uint8","name":"TARGET_ALU","value":"2"},{"k":"const","t":"uint8 TARGET_ALL = 3","type":"uint8","name":"TARGET_ALL","value":"3"}]},{"kind":"msg","name":"MappingTargetInfo","path":"riptide_msgs/msg/MappingTargetInfo.msg","lines":[{"k":"comment","t":"# Sets the target for the mapping system"},{"k":"comment","t":"# If the object is set to null/None the mapping system will use the closest object"},{"k":"field","t":"string target_object","type":"string","name":"target_object"},{"k":"blank","t":""},{"k":"comment","t":"# Locks the map so nothing will change"},{"k":"field","t":"bool lock_map","type":"bool","name":"lock_map"}]},{"kind":"msg","name":"PathSegment","path":"riptide_msgs/msg/PathSegment.msg","lines":[{"k":"comment","t":"# How a FollowPath goal reaches one of its path points from the point before it"},{"k":"comment","t":"# (the first from where the vehicle is). Points are in the path point's header frame."},{"k":"blank","t":""},{"k":"const","t":"uint8 LINE=0","type":"uint8","name":"LINE","value":"0"},{"k":"const","t":"uint8 ARC=1","type":"uint8","name":"ARC","value":"1"},{"k":"field","t":"uint8 shape","type":"uint8","name":"shape"},{"k":"blank","t":""},{"k":"comment","t":"# ARC: turns `sweep` radians about `center` (+ = counterclockwise seen from above,"},{"k":"comment","t":"# about the frame's +z; more than 2*pi goes round more than once). Only the"},{"k":"comment","t":"# horizontal part of center is used. The path point sets where the arc ends:"},{"k":"comment","t":"# its distance from center (the radius changes linearly with the angle, so a"},{"k":"comment","t":"# different end radius makes a spiral) and its depth (a helix); the arc ends at"},{"k":"comment","t":"# that radius and depth, `sweep` from where it started."},{"k":"field","t":"geometry_msgs/Point center","type":"geometry_msgs/Point","name":"center"},{"k":"field","t":"float64 sweep","type":"float64","name":"sweep"},{"k":"blank","t":""},{"k":"comment","t":"# Heading (yaw) while following this segment; roll and pitch always blend from"},{"k":"comment","t":"# the previous point's orientation to this one's."},{"k":"const","t":"uint8 HEADING_WAYPOINT=0 # blend the yaw from the previous point's to this one's","type":"uint8","name":"HEADING_WAYPOINT","value":"0","comment":"# blend the yaw from the previous point's to this one's"},{"k":"const","t":"uint8 HEADING_PATH=1     # face the direction of travel","type":"uint8","name":"HEADING_PATH","value":"1","comment":"# face the direction of travel"},{"k":"const","t":"uint8 HEADING_LOOK_AT=2  # face look_at","type":"uint8","name":"HEADING_LOOK_AT","value":"2","comment":"# face look_at"},{"k":"field","t":"uint8 heading","type":"uint8","name":"heading"},{"k":"field","t":"geometry_msgs/Point look_at","type":"geometry_msgs/Point","name":"look_at"},{"k":"comment","t":"# HEADING_LOOK_AT: if set, look_at is in this TF frame instead and follows it"},{"k":"comment","t":"# live while on this segment (the frame may move; the path follows its points' own frames, not this one)."},{"k":"field","t":"string look_at_frame","type":"string","name":"look_at_frame"},{"k":"field","t":"float64 yaw_offset # added to the HEADING_PATH / HEADING_LOOK_AT yaw; pi/2 travels sideways","type":"float64","name":"yaw_offset","comment":"# added to the HEADING_PATH / HEADING_LOOK_AT yaw; pi/2 travels sideways"},{"k":"field","t":"float64 spin       # extra yaw over the segment (+ = counterclockwise), spread by progress; 2*pi = one turn","type":"float64","name":"spin","comment":"# extra yaw over the segment (+ = counterclockwise), spread by progress; 2*pi = one turn"},{"k":"comment","t":"# Steady spin: extra yaw per metre travelled (+ = counterclockwise), carried on"},{"k":"comment","t":"# across segments as one continuous spin; the path's total is rounded to whole"},{"k":"comment","t":"# turns so it still ends on its planned heading. About rad/s / cruise speed."},{"k":"field","t":"float64 spin_rate","type":"float64","name":"spin_rate"}]},{"kind":"msg","name":"TrajPoint","path":"riptide_msgs/msg/TrajPoint.msg","lines