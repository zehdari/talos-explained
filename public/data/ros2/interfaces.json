{"k":"const","t":"uint8 DETECT_NONE = 0","type":"uint8","name":"DETECT_NONE","value":"0"},{"k":"const","t":"uint8 DETECT_STBD = 2","type":"uint8","name":"DETECT_STBD","value":"2"},{"k":"const","t":"uint8 DETECT_PORT = 1","type":"uint8","name":"DETECT_PORT","value":"1"}]},{"kind":"msg","name":"ControllerCommand","path":"riptide_msgs/msg/ControllerCommand.msg","lines":[{"k":"const","t":"uint8 POSITION = 3","type":"uint8","name":"POSITION","value":"3"},{"k":"const","t":"uint8 VELOCITY = 2","type":"uint8","name":"VELOCITY","value":"2"},{"k":"const","t":"uint8 FEEDFORWARD = 1","type":"uint8","name":"FEEDFORWARD","value":"1"},{"k":"const","t":"uint8 DISABLED = 0","type":"uint8","name":"DISABLED","value":"0"},{"k":"blank","t":""},{"k":"field","t":"uint8 mode","type":"uint8","name":"mode"},{"k":"field","t":"geometry_msgs/Vector3 setpoint_vect","type":"geometry_msgs/Vector3","name":"setpoint_vect"},{"k":"field","t":"geometry_msgs/Quaternion setpoint_quat","type":"geometry_msgs/Quaternion","name":"setpoint_quat"}]},{"kind":"msg","name":"Depth","path":"riptide_msgs/msg/Depth.msg","lines":[{"k":"field","t":"std_msgs/Header header","type":"std_msgs/Header","name":"header"},{"k":"field","t":"float32 depth","type":"float32","name":"depth"},{"k":"field","t":"float32 variance","type":"float32","name":"variance"}]},{"kind":"msg","name":"DshotCommand","path":"riptide_msgs/msg/DshotCommand.msg","lines":[{"k":"field","t":"int16[8] values","type":"int16","name":"values","array":"8"},{"k":"blank","t":""},{"k":"const","t":"int16 DSHOT_MIN = -999","type":"int16","name":"DSHOT_MIN","value":"-999"},{"k":"const","t":"int16 DSHOT_MAX = 999","type":"int16","name":"DSHOT_MAX","value":"999"}]},{"kind":"msg","name":"DshotPartialTelemetry","path":"riptide_msgs/msg/DshotPartialTelemetry.msg","lines":[{"k":"comment","t":"# Note that these values are not gaurenteed to be sampled at the same time internally. Cases can occur where"},{"k":"comment","t":"# thrusters_moving is true, disabled_flags will be non-zero. When using telemetry, ensure that you do not depend that"},{"k":"comment","t":"# there be coherency across values. This was done to simplify firmware, so it doesn't need lock out the entire DShot"},{"k":"comment","t":"# control loop + interrupt system to sample telemetry."},{"k":"blank","t":""},{"k":"comment","t":"# Set to true if the ESC board considers that the board is receiving enough power for ESCs to start up"},{"k":"field","t":"bool escs_powered","type":"bool","name":"escs_powered"},{"k":"comment","t":"# Set to true if the DShot controller is commanding a non-zero value to any thruster"},{"k":"field","t":"bool thrusters_moving","type":"bool","name":"thrusters_moving"},{"k":"comment","t":"# Contains the first thruster index for this packet. Used to distinguish across ESC boards"},{"k":"field","t":"uint8 start_thruster_num","type":"uint8","name":"start_thruster_num"},{"k":"comment","t":"# Bitwise array of reasons that dshot is disabled. Can be useful when diagnosing why thrusters are not moving"},{"k":"field","t":"uint8 disabled_flags","type":"uint8","name":"disabled_flags"},{"k":"comment","t":"# The measured voltage of the ESC board V+ rail from the RP2040 analog pin. Used when determining if the ESC board is on"},{"k":"field","t":"float32 vcc_voltage","type":"float32","name":"vcc_voltage"},{"k":"comment","t":"# The time delta in microseconds since the last telemetry packet was sent. Useful for computing controller rates"},{"k":"field","t":"uint32 packet_delta_us","type":"uint32","name":"packet_delta_us"},{"k":"comment","t":"# The total number of controller ticks since the last telemetry packet was sent"},{"k":"field","t":"uint16 tick_cnt","type":"uint16","name":"tick_cnt"},{"k":"comment","t":"# Array of individual ESC's telemetry data"},{"k":"field","t":"riptide_msgs2/DshotSingleTelemetry[4] esc_telemetry","type":"riptide_msgs2/DshotSingleTelemetry","name":"esc_telemetry","array":"4"}]},{"kind":"msg","name":"DshotRPMFeedback","path":"riptide_msgs/msg/DshotRPMFeedback.msg","lines":[{"k":"comment","t":"# Bitwise mask containing which elements if rpm are valid"},{"k":"field","t":"uint8 rpm_valid_mask","type":"uint8","name":"rpm_valid_mask"},{"k":"blank","t":""},{"k":"comment","t":"# The signed RPM values sent back"},{"k":"field","t":"int16[8] rpm","type":"int16","name":"rpm","array":"8"}]},{"kind":"msg","name":"DshotSingleTelemetry","path":"riptide_msgs/msg/DshotSingleTelemetry.msg","lines":[{"k":"comment","t":"# Set to true if the ESC is communicating over UART telemetry"},{"k":"field","t":"bool esc_online","type":"bool","name":"esc_online"},{"k":"comment","t":"# Set to true if the thruster is ready and able to generate thrust, false if an error is detected"},{"k":"comment","t":"# It is possible for an ESC to be online, but the thruster to be unplugged or damaged. If no movement is detected, the"},{"k":"comment","t":"# thruster will be disabled until the ESC is power cycled, and all dshot output will be disabled on this thruster"},{"k":"field","t":"bool thruster_ready","type":"bool","name":"thruster_ready"},{"k":"comment","t":"# Temperature of ESC in Deg C from DShot UART Telemetry"},{"k":"field","t":"uint8 temperature_c","type":"uint8","name":"temperature_c"},{"k":"comment","t":"# Signed RPM of the ESC from DShot UART Telemetry"},{"k":"field","t":"int16 rpm","type":"int16","name":"rpm"},{"k":"comment","t":"# Voltage in Volts of the ESC V+ rail from DShot UART Telemetry"},{"k":"field","t":"float32 voltage","type":"float32","name":"voltage"},{"k":"comment","t":"# Current flow in Amps through the ESC from DShot UART Telemetry"},{"k":"field","t":"float32 current","type":"float32","name":"current"},{"k":"comment","t":"# Current Consumption in Amp Hours of the ESC from DShot UART Telemetry"},{"k":"field","t":"float32 consumption_ah","type":"float32","name":"consumption_ah"},{"k":"comment","t":"# Count of missed controller ticks (but still sending old commands) since last telemetry packet"},{"k":"comment","t":"# A non-zero value is acceptable for this field, but means that this thruster's controller skipped control loop ticks"},{"k":"field","t":"uint16 dshot_missed_cnt","type":"uint16","name":"dshot_missed_cnt"},{"k":"comment","t":"# Count of controller ticks where the ESC was disabled due to no dshot RPM feedback"},{"k":"comment","t":"# A non-zero value in this field means that the controller operation is impacted, as it has killed that ESC's controller"},{"k":"field","t":"uint16 dshot_offline_cnt","type":"uint16","name":"dshot_offline_cnt"},{"k":"comment","t":"# Count of total uart telemtry packets received sent since last telemetry packet"},{"k":"field","t":"uint16 uart_success_cnt","type":"uint16","name":"uart_success_cnt"},{"k":"comment","t":"# Count of missed/corrupted uart telemetry responses (but not enough to mark ESC as not present) since last telemetry packet"},{"k":"comment","t":"# A non-zero value in this field is okay, but that means that uart telemetry may be a bit stale"},{"k":"field","t":"uint16 uart_missed_cnt","type":"uint16","name":"uart_missed_cnt"},{"k":"comment","t":"# Count of uart telemetry requests that had the ESC considered not present since last telemetry packet"},{"k":"comment","t":"# A non-zero value in this field means that there are periods when this telemetry packet would report not present"},{"k":"field","t":"uint16 uart_disabled_cnt","type":"uint16","name":"uart_disabled_cnt"}]},{"kind":"msg","name":"DynamixelStatus","path":"riptide_msgs/msg/DynamixelStatus.msg","lines":[{"k":"field","t":"uint16 model","type":"uint16","name":"model"},{"k":"field","t":"uint8 fw_version","type":"uint8","name":"fw_version"},{"k":"field","t":"uint8 id","type":"uint8","name":"id"},{"k":"field","t":"uint8 hw_err_status","type":"uint8","name":"hw_err_status"},{"k":"field","t":"bool torque_enable","type":"bool","name":"torque_enable"},{"k":"field","t":"bool moving","type":"bool","name":"moving"},{"k":"field","t":"uint16 voltage","type":"uint16","name":"voltage"},{"k":"