{
 "node": "/talos/yolo_orientation",
 "source": "ros2 param dump /talos/yolo_orientation while the Nereus full stack ran (sim.launch.py active_control_model:=mpc mpc_model:=sim); values are what the node actually loaded in sim",
 "parameters": {
  "active_camera": "ffc",
  "class_detect_shrink": 0.0,
  "cloud_color_mode": "class",
  "depth_buffer_size": 15,
  "depth_mad_scale": 3.0,
  "depth_min_spread": 0.05,
  "dfc_class_id_map": "{ 0: 'bandage', 1: 'blood', 2: 'fire', 3: 'helmet', 4: 'nut_and_bolt', 5: 'pill', 6: 'plug', 7: 'warning' }",
  "dfc_iou": 0.9,
  "dfc_model": "dfc_rs_26.pt",
  "dfc_threshold": 0.8,
  "export": true,
  "ffc_class_id_map": "{ 0: 'blood', 1: 'buoy', 2: 'compass', 3: 'circle', 4: 'fire', 5: 'hammer_and_wrench', 6: 'slalom', 7: 'sos', 8: 'ambulance', 9: 'fire_engine', 10: 'magnet' }",
  "ffc_iou": 0.7,
  "ffc_model": "rs26_ffc_finals.pt",
  "ffc_threshold": 0.65,
  "grid_step": 8,
  "log_processing_time": false,
  "marker_lifetime": 5.0,
  "max_depth_age": 1.0,
  "max_sample_points": 500,
  "min_points": 5,
  "print_camera_info": false,
  "publish_box_markers": false,
  "publish_interval": 0.1,
  "robot_namespace": "talos",
  "slalom_history_size": 1,
  "torpedo_task_camera": "ffc",
  "use_incoming_timestamp": true,
  "use_sim_time": false
 }
}